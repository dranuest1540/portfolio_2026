<main class="form-page auth-page">
	<div class="auth-container">
		<a href="/" class="manage-back"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Back to portfolio</a>
		<section class="auth-panel">
			<a href="/" class="brand-link auth-brand" aria-label="Danu Prastyo home">
				<span class="brand-mark">DP</span>
				<span class="brand-name">Danu <strong>Prastyo</strong></span>
			</a>

			<p class="eyebrow">PORTFOLIO ADMIN</p>
			<h1 class="form-title">Welcome back</h1>
			<p class="form-intro">Sign in to manage your experience and projects.</p>

			{{#if message}}
				<div class="form-alert" role="alert">
					<i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
					<span>{{message}}</span>
				</div>
			{{/if}}

			<form action="/login/auth" method="POST" class="manage-form auth-form">
				<div class="mb-3">
					<label class="form-label" for="inputEmail">Email address</label>
					<input type="email" class="form-control" id="inputEmail" name="email" placeholder="you@example.com" autocomplete="username" required>
				</div>
				<div class="mb-4">
					<label class="form-label" for="inputPassword">Password</label>
					<div class="password-field">
						<input type="password" class="form-control" id="inputPassword" name="password" placeholder="Enter your password" autocomplete="current-password" aria-describedby="passwordHelp" required>
						<button type="button" class="password-toggle" data-password-toggle="inputPassword" aria-controls="inputPassword" aria-label="Show password" aria-pressed="false">
							<i class="fa-regular fa-eye" aria-hidden="true"></i>
						</button>
					</div>
					<small class="form-hint" id="passwordHelp">Your password stays private.</small>
				</div>
				<button class="button button-primary auth-submit" type="submit">
					Sign in <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
				</button>
			</form>
		</section>
		<p class="auth-footnote">Danu Prastyo <span>·</span> Portfolio</p>
	</div>
</main>

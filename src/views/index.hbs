{{> navbar}}

<main class="portfolio-page">
	<section class="hero-section page-container" id="home">
		<div class="hero-copy">
			<div class="availability-pill">
				<span class="availability-dot"></span>
				Open to work & collaboration
			</div>
			<p class="eyebrow">FULL-STACK DEVELOPER <span>/</span> BOGOR, INDONESIA</p>
			<h1>Turning ideas into <span class="text-accent">digital experiences.</span></h1>
			<p class="hero-description">
				Hi, I'm Danu Prastyo. I build responsive web applications and practical digital products, from thoughtful interfaces to dependable backend systems.
			</p>
			<div class="hero-actions">
				<a href="#project" class="button button-primary">
					Explore my work <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
				</a>
				<a href="#contact" class="button button-secondary">Get in touch</a>
				<a href="/assets/images/cv_danu.jpg" class="resume-link" target="_blank" rel="noopener noreferrer">
					Resume <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
				</a>
			</div>
			<div class="hero-socials">
				<span class="hero-location"><i class="fa-solid fa-location-dot" aria-hidden="true"></i> Bogor, Indonesia</span>
				<a href="https://github.com/dranuest1540" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
					<i class="fa-brands fa-github" aria-hidden="true"></i>
				</a>
				<a href="https://www.linkedin.com/in/dranuest1540/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
					<i class="fa-brands fa-linkedin-in" aria-hidden="true"></i>
				</a>
				<a href="mailto:danuprastyo62@gmail.com" aria-label="Email">
					<i class="fa-regular fa-envelope" aria-hidden="true"></i>
				</a>
			</div>
		</div>

		<div class="hero-visual">
			<div class="hero-image-backdrop"></div>
			<div class="hero-image-frame">
				<img src="/assets/images/profile.jpg" alt="Danu Prastyo" class="hero-image">
			</div>
			<div class="hero-image-caption">
				<span class="caption-mark">DP</span>
				<span><strong>Curious by nature.</strong><small>Builder by choice.</small></span>
			</div>
			<div class="hero-orbit orbit-one"></div>
			<div class="hero-orbit orbit-two"></div>
		</div>
	</section>

	<section class="tech-section page-container" id="tech-stack">
		<div class="section-heading">
			<div>
				<p class="eyebrow">TOOLS OF THE TRADE</p>
				<h2>Technology I work with</h2>
			</div>
			<p class="section-intro">A practical toolkit for turning ideas into useful products.</p>
		</div>
		<div class="swiper tech-swiper" role="region" aria-label="Technology stack carousel" tabindex="0">
			<div class="swiper-wrapper">
				<div class="swiper-slide"><div class="tech-item"><img src="/assets/images/tech-logo/JavaScript-logo.png" alt=""><span>JavaScript</span></div></div>
				<div class="swiper-slide"><div class="tech-item"><img src="/assets/images/tech-logo/Node-logo.png" alt=""><span>Node.js</span></div></div>
				<div class="swiper-slide"><div class="tech-item"><img src="/assets/images/tech-logo/Express-logo.png" alt=""><span>Express.js</span></div></div>
				<div class="swiper-slide"><div class="tech-item"><img src="/assets/images/tech-logo/Laravel-logo.png" alt=""><span>Laravel</span></div></div>
				<div class="swiper-slide"><div class="tech-item"><img src="/assets/images/tech-logo/PHP-logo.png" alt=""><span>PHP</span></div></div>
				<div class="swiper-slide"><div class="tech-item"><img src="/assets/images/tech-logo/Postgresql-logo.png" alt=""><span>PostgreSQL</span></div></div>
				<div class="swiper-slide"><div class="tech-item"><img src="/assets/images/tech-logo/mysql-logo.png" alt=""><span>MySQL</span></div></div>
				<div class="swiper-slide"><div class="tech-item"><img src="/assets/images/tech-logo/Bootstrap_logo.png" alt=""><span>Bootstrap</span></div></div>
				<div class="swiper-slide"><div class="tech-item"><img src="/assets/images/tech-logo/Tailwind-logo.png" alt=""><span>Tailwind CSS</span></div></div>
				<div class="swiper-slide"><div class="tech-item"><img src="/assets/images/tech-logo/Dart-logo.png" alt=""><span>Dart</span></div></div>
				<div class="swiper-slide"><div class="tech-item"><img src="/assets/images/tech-logo/fultter-logo.png" alt=""><span>Flutter</span></div></div>
				<div class="swiper-slide"><div class="tech-item"><img src="/assets/images/tech-logo/html-logo.png" alt=""><span>HTML</span></div></div>
				<div class="swiper-slide"><div class="tech-item"><img src="/assets/images/tech-logo/css-logo.png" alt=""><span>CSS</span></div></div>
				<div class="swiper-slide"><div class="tech-item"><img src="/assets/images/tech-logo/postman-logo.png" alt=""><span>Postman</span></div></div>
				<div class="swiper-slide"><div class="tech-item"><img src="/assets/images/tech-logo/react-logo.png" alt=""><span>React</span></div></div>
				<div class="swiper-slide"><div class="tech-item"><img src="/assets/images/tech-logo/docker-logo.png" alt=""><span>Docker</span></div></div>
			</div>
		</div>
	</section>

	<section class="content-section page-container" id="experience">
		<div class="section-heading">
			<div>
				<p class="eyebrow">WHERE I'VE BEEN</p>
				<h2>Experience</h2>
			</div>
			{{#if user}}
				<a href="/formExperience" class="button button-secondary admin-add">
					<i class="fa-solid fa-plus" aria-hidden="true"></i> Add experience
				</a>
			{{/if}}
		</div>

		{{#if experience}}
			<div class="experience-list">
				{{#each experience}}
					<article class="experience-card">
						<div class="experience-company">
							<img src="{{this.company_logo}}" alt="{{this.company_name}} logo" class="experience-logo">
							<span class="experience-dates">{{formatDate this.start_date}} — {{formatDate this.end_date}}</span>
						</div>
						<div class="experience-details">
							<h3>{{this.position}}</h3>
							<p class="experience-name">{{this.company_name}}</p>
							<ul class="responsibility-list">
								{{#each this.responsibilities}}
									<li>{{this}}</li>
								{{/each}}
							</ul>
							<div class="tag-list">
								{{#each this.tech_stack}}
									<span class="tech-tag">{{this}}</span>
								{{/each}}
							</div>
							{{#if ../user}}
								<div class="admin-actions">
									<a href="/formExperience/edit/{{this.id}}" class="admin-link">Edit</a>
									<a href="/formExperience/destroy/{{this.id}}" class="admin-link admin-link-danger">Delete</a>
								</div>
							{{/if}}
						</div>
					</article>
				{{/each}}
			</div>
		{{else}}
			<p class="empty-state">Experience details will be added soon.</p>
		{{/if}}
	</section>

	<section class="content-section page-container" id="project">
		<div class="section-heading">
			<div>
				<p class="eyebrow">SELECTED WORK</p>
				<h2>Projects</h2>
			</div>
			{{#if user}}
				<a href="/formProject" class="button button-secondary admin-add">
					<i class="fa-solid fa-plus" aria-hidden="true"></i> Add project
				</a>
			{{/if}}
		</div>

		{{#if project}}
			<div class="project-grid">
				{{#each project}}
					<article class="project-card">
						<div class="project-image-wrap">
							<img src="{{this.project_image}}" alt="{{this.title}} project preview" class="project-image">
							<span class="project-number">Featured work</span>
						</div>
						<div class="project-content">
							<div class="project-title-row">
								<h3>{{this.title}}</h3>
								<span class="project-type">{{#if (eq this.repository_status "public")}}Open source{{else}}Private work{{/if}}</span>
							</div>
							<p class="project-description">{{this.description}}</p>
							<div class="tag-list project-tags">
								{{#each this.tech_stack}}
									<span class="tech-tag">{{this}}</span>
								{{/each}}
							</div>
							<div class="project-links">
								{{#if (eq this.repository_status "public")}}
									<a href="{{this.link_repository}}" target="_blank" rel="noopener noreferrer">
										<i class="fa-brands fa-github" aria-hidden="true"></i> Repository
									</a>
								{{else}}
									<span class="link-muted"><i class="fa-solid fa-lock" aria-hidden="true"></i> Private repository</span>
								{{/if}}
								{{#if (eq this.demo_status "available")}}
									<a href="{{this.link_demo}}" target="_blank" rel="noopener noreferrer">
										Live demo <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
									</a>
								{{/if}}
							</div>
							{{#if ../user}}
								<div class="admin-actions">
									<a href="/formProject/edit/{{this.id}}" class="admin-link">Edit</a>
									<a href="/formProject/destroy/{{this.id}}" class="admin-link admin-link-danger">Delete</a>
								</div>
							{{/if}}
						</div>
					</article>
				{{/each}}
			</div>
		{{else}}
			<p class="empty-state">Projects are on their way. Check back soon.</p>
		{{/if}}
	</section>

	<section class="contact-section page-container" id="contact">
		<div class="contact-card">
			<p class="eyebrow">HAVE A PROJECT IN MIND?</p>
			<h2>Let's make something <span class="text-accent">meaningful.</span></h2>
			<p>Have an opportunity, a question, or an idea to explore? I'd love to hear from you.</p>
			<div class="contact-actions">
				<a href="mailto:danuprastyo62@gmail.com" class="button button-primary">
					Start a conversation <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
				</a>
				<a href="https://wa.me/6285173451540" target="_blank" rel="noopener noreferrer" class="contact-phone">
					<i class="fa-brands fa-whatsapp" aria-hidden="true"></i> WhatsApp
				</a>
			</div>
		</div>
	</section>

	{{> footer}}
</main>
